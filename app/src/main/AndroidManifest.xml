<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Automation allow-list (docs/automation.md): "‹App› wants to add notes"
        notification when an app that isn't allowed yet calls the API. Asked
        for when the user turns automation on (Android 13+).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Package visibility for the automation allow-list. On Android 11+ the
        system hides the referrer of an activity launch, and PackageManager
        hides an app's signing certificates, unless the calling app is
        visible to us. Apps with a launcher icon covers Tasker, MacroDroid,
        Automate and Tasker App Factory exports, without QUERY_ALL_PACKAGES.
        Notes of Fruit never lists installed apps; it only looks up the one
        package that called it.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
        Backup is OFF, on purpose. The app's private data holds:
          * files/datastore/device_identity.preferences_pb: this install's
            CRDT replica UUID. Restoring it onto another device would make two
            installs write as the same replica and corrupt notes.
          * app_webview/: the WebView cookie jar with the iCloud session.
        allowBackup="false" covers Auto Backup and adb backup on API 30 and
        below (fullBackupContent excludes everything as a second guard). On
        API 31+ allowBackup does NOT stop device-to-device transfer, so
        dataExtractionRules excludes every domain for both cloud backup and
        device transfer. A new device signs in again and creates a fresh
        replica UUID.
    -->
    <application
        android:name=".NotesOfFruitApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.NotesOfFruit">
        <!--
            MainActivity: exported="true" because it is the launcher entry.
            It reads no extras from its intent; requests from other entry
            points arrive through the in-process PendingIncoming holder.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Static "New note" launcher shortcut (targets IntegrationEntryActivity). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            IntegrationEntryActivity: invisible trampoline for share-in,
            "Add to Notes" (text selection), launcher shortcuts, the QS tile
            and the note-taking role.

            exported="true" with no permission, on purpose: the share sheet,
            the text-selection menu, the launcher and the notes role all start
            it on behalf of other apps. Its input is untrusted, so it can only:
              * open a NEW, UNSAVED draft prefilled with the shared text (the
                user sees the editor; nothing reaches iCloud until they save);
              * open an existing note, and only with the per-install shortcut
                token that our own shortcuts carry (ShortcutToken), so other
                apps can't open notes through it.
            It never saves and never returns note content (PROCESS_TEXT is
            read-only: it finishes without a result). It starts MainActivity,
            which never reads request extras itself.

            Not showWhenLocked: launching it from the lock screen (notes role)
            asks for an unlock first, so notes are never shown over the
            keyguard. Text MIME types only: attachments can't be written yet.
        -->
        <activity
            android:name=".integrations.IntegrationEntryActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="@string/process_text_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Note-taking role (RoleManager.ROLE_NOTES, API 34+). -->
            <intent-filter>
                <action android:name="android.intent.action.CREATE_NOTE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Quick Settings "New note" tile. exported="true" is required for
            System UI to bind it; BIND_QUICK_SETTINGS_TILE is a signature
            permission only System UI holds. A tap opens an empty draft via
            IntegrationEntryActivity (after unlocking, if locked).
        -->
        <service
            android:name=".integrations.NewNoteTileService"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_new_note"
            android:label="@string/tile_new_note_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <!--
            Automation API (docs/automation.md). exported="true" with NO
            android:permission, on purpose: stock automation apps (Tasker,
            MacroDroid, Automate) can't hold a custom permission their own
            manifest doesn't declare, so a permission made the API unusable.
            Instead every call has to pass, in code:
              1. the in-app "Allow automation apps" toggle (off by default);
              2. caller identification: the receiver trusts only the creator
                 package of the caller's result_pending_intent (unforgeable)
                 or, on Android 14+, a sender that opted in to sharing its
                 identity; the activity trusts launchedFromPackage (14+,
                 opt-in), callingPackage (startActivityForResult) or the
                 system referrer (Android 11+, and only when the intent has
                 no EXTRA_REFERRER override). Unidentified callers are
                 refused;
              3. the per-app allow-list in Settings -> Allowed apps, keyed by
                 package name AND signing-certificate SHA-256. Unknown apps
                 are recorded as pending (no request content kept) and the
                 user is notified; nothing is written.
            No delete, overwrite or read-back actions exist.
        -->
        <!-- ExportedReceiver: no permission on purpose, see above. -->
        <receiver
            android:name=".automation.AutomationReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="io.github.hanthor.notesoffruit.action.CREATE_NOTE" />
                <action android:name="io.github.hanthor.notesoffruit.action.APPEND_TO_NOTE" />
            </intent-filter>
        </receiver>

        <!--
            Automation API as an activity: OPEN_NOTE (a receiver can't start
            activities from the background) and CREATE_NOTE / APPEND_TO_NOTE
            for apps that can only start activities without a PendingIntent.
            Invisible; finishes in onCreate. Same three checks as above.
        -->
        <activity
            android:name=".automation.AutomationActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="io.github.hanthor.notesoffruit.action.OPEN_NOTE" />
                <action android:name="io.github.hanthor.notesoffruit.action.CREATE_NOTE" />
                <action android:name="io.github.hanthor.notesoffruit.action.APPEND_TO_NOTE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Target of the "‹App› wants to add notes" notification: opens
            Settings -> Allowed apps. Not exported; only our own notification's
            PendingIntent starts it.
        -->
        <activity
            android:name=".automation.AutomationReviewActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!--
            "Recent notes" home-screen widget (Glance). exported="true" is
            required: the system's AppWidgetService delivers APPWIDGET_UPDATE
            (and the other appwidget broadcasts) to it. Guarded by
            BIND_APPWIDGET, a signature/privileged permission only the system
            holds, so other apps can't send it broadcasts. It reads the local
            cache only, never the network; while the app lock is on it shows
            no titles, and after sign-out no content. Taps go through
            IntegrationEntryActivity (new draft, or a note with the
            per-install shortcut token).
        -->
        <receiver
            android:name=".widget.RecentNotesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recent_notes_widget_info" />
        </receiver>

        <!--
            Read-only documents provider: folders -> notes as Markdown in the
            system file picker. exported="true" because the documents UI
            (another app) binds it; MANAGE_DOCUMENTS (signature|privileged,
            held by the system documents UI only) guards it, as every
            DocumentsProvider must. Apps reach a document only through the
            picker's per-URI grant (grantUriPermissions). No write, delete,
            rename or create. No roots while the app lock is on or nobody is
            signed in.
        -->
        <provider
            android:name=".documents.NotesDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- The adb DebugReceiver is declared in src/debug/AndroidManifest.xml
             so it never ships in release builds. -->
    </application>

</manifest>
